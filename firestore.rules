rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerified() {
      // Password accounts must confirm their email; other providers (e.g. Google)
      // arrive with a pre-verified email address from the provider itself.
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider != 'password';
    }

    match /users/{userId}/{document=**} {
      allow get: if request.auth != null && request.auth.uid == userId && isVerified();
      allow list: if request.auth != null && request.auth.uid == userId && request.query.limit <= 100 && isVerified();
      allow write: if request.auth != null && request.auth.uid == userId && isVerified();
      allow delete: if request.auth != null && request.auth.uid == userId && isVerified();
    }
  }
}
